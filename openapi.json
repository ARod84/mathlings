{
  "openapi": "3.1.0",
  "info": {
    "title": "Mathlings API",
    "description": "Read-only access to the learning topics behind the Mathlings games: what each topic requires first, and the mistakes children typically make.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Service health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/domains": {
      "get": {
        "tags": [
          "Topics"
        ],
        "summary": "Domains with topic counts",
        "operationId": "list_domains_api_v1_domains_get",
        "parameters": [
          {
            "name": "in_scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "true: mathematics for ages 7-12. false: prerequisite-only topics.",
              "default": true,
              "title": "In Scope"
            },
            "description": "true: mathematics for ages 7-12. false: prerequisite-only topics."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DomainCount"
                  },
                  "title": "Response List Domains Api V1 Domains Get"
                }
              }
            }
          },
          "503": {
            "description": "The taxonomy has not been imported yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/topics": {
      "get": {
        "tags": [
          "Topics"
        ],
        "summary": "Search and page through topics",
        "operationId": "list_topics_api_v1_topics_get",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact domain name.",
              "title": "Domain"
            },
            "description": "Exact domain name."
          },
          {
            "name": "in_scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "true: mathematics for ages 7-12. false: prerequisite-only topics.",
              "default": true,
              "title": "In Scope"
            },
            "description": "true: mathematics for ages 7-12. false: prerequisite-only topics."
          },
          {
            "name": "age",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 18,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Topics whose age range contains this age.",
              "title": "Age"
            },
            "description": "Topics whose age range contains this age."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "CONCEPTUAL",
                    "PROCEDURAL",
                    "REPRESENTATIONAL",
                    "LANGUAGE",
                    "META"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive search in name and description.",
              "title": "Q"
            },
            "description": "Case-insensitive search in name and description."
          },
          {
            "name": "has_research",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Has Research"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicPage"
                }
              }
            }
          },
          "503": {
            "description": "The taxonomy has not been imported yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/topics/{topic_id}": {
      "get": {
        "tags": [
          "Topics"
        ],
        "summary": "One topic in full",
        "operationId": "get_topic_api_v1_topics__topic_id__get",
