  "components": {
    "schemas": {
      "DomainCount": {
        "properties": {
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "topic_count": {
            "type": "integer",
            "title": "Topic Count"
          }
        },
        "type": "object",
        "required": [
          "subject",
          "domain",
          "topic_count"
        ],
        "title": "DomainCount"
      },
      "ErrorBody": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorBody"
      },
      "ErrorPatternOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "pattern": {
            "type": "string",
            "title": "Pattern"
          },
          "next_move": {
            "type": "string",
            "title": "Next Move"
          },
          "distractor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distractor"
          },
          "revealed_by": {
            "type": "string",
            "title": "Revealed By"
          },
          "reteach_prerequisite": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TopicSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "pattern",
          "next_move",
          "distractor",
          "revealed_by",
          "reteach_prerequisite"
        ],
        "title": "ErrorPatternOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "taxonomy_loaded": {
            "type": "boolean",
            "title": "Taxonomy Loaded"
          },
          "topic_count": {
            "type": "integer",
            "title": "Topic Count"
          }
        },
        "type": "object",
        "required": [
          "taxonomy_loaded",
          "topic_count"
        ],
        "title": "Health"
      },
      "PrerequisiteItem": {
        "properties": {
          "topic": {
            "$ref": "#/components/schemas/TopicSummary"
          },
          "strength": {
            "type": "string",
            "enum": [
              "hard",
              "soft"
            ],
            "title": "Strength"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "distance": {
            "type": "integer",
            "title": "Distance",
            "description": "1 for a direct prerequisite, 2 for one of its own, etc."
          },
          "required_by": {
            "type": "string",
            "title": "Required By",
            "description": "Id of the topic that directly needs this one. For a direct prerequisite that is the topic asked about."
          }
        },
        "type": "object",
        "required": [
          "topic",
          "strength",
          "reason",
          "distance",
          "required_by"
        ],
        "title": "PrerequisiteItem"
      },
      "ResearchActivity": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "learner_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Learner Actions"
          },
          "intended_insight": {
            "type": "string",
            "title": "Intended Insight"
          },
          "feedback": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Feedback"
          }
        },
        "type": "object",
        "required": [
          "title",
          "learner_actions",
          "intended_insight",
          "feedback"
        ],
        "title": "ResearchActivity"
      },
      "SourceInfo": {
        "properties": {
          "commit_sha": {
            "type": "string",
            "title": "Commit Sha"
          },
          "taxonomy_version": {
            "type": "string",
            "title": "Taxonomy Version"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Imported At"
          },
          "attribution": {
            "type": "string",
            "title": "Attribution"
          }
        },
        "type": "object",
        "required": [
          "commit_sha",
          "taxonomy_version",
          "imported_at",
          "attribution"
        ],
        "title": "SourceInfo"
      },
      "TopicDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "age_range_start": {
            "type": "integer",
            "title": "Age Range Start"
          },
          "age_range_end": {
            "type": "integer",
            "title": "Age Range End"
          },
          "in_scope": {
            "type": "boolean",
            "title": "In Scope",
            "description": "True for mathematics topics for ages 7-12. False for topics that are only here because an in-scope topic needs them first."
          },
          "has_research": {
            "type": "boolean",
            "title": "Has Research"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence"
          },
          "centrality": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Centrality"
          },
          "assessment_prompt": {
            "type": "string",
            "title": "Assessment Prompt",
            "description": "The assessment prompt with the child's name filled in, or worded to 'you' when no name is given."
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "subject",
          "domain",
          "type",
          "age_range_start",
          "age_range_end",
          "in_scope",
          "has_research",
          "description",
