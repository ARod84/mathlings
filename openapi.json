              }
            }
          },
          "503": {
            "description": "The taxonomy has not been imported yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown topic id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicNotFoundBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/topics/{topic_id}/prerequisites": {
      "get": {
        "tags": [
          "Prerequisite graph"
        ],
        "summary": "What the topic requires first",
        "operationId": "get_prerequisites_api_v1_topics__topic_id__prerequisites_get",
        "parameters": [
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Topic Id"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "direct",
                "all"
              ],
              "type": "string",
              "description": "direct: one step. all: the whole chain, nearest first.",
              "default": "direct",
              "title": "Depth"
            },
            "description": "direct: one step. all: the whole chain, nearest first."
          },
          {
            "name": "strength",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "hard",
                    "soft"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Follow only edges of this strength.",
              "title": "Strength"
            },
            "description": "Follow only edges of this strength."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PrerequisiteItem"
                  },
                  "title": "Response Get Prerequisites Api V1 Topics  Topic Id  Prerequisites Get"
                }
              }
            }
          },
          "503": {
            "description": "The taxonomy has not been imported yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Unknown topic id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicNotFoundBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
